<?xml version="1.0" encoding="utf-8"?>
<!-- En 2.3 la cámara necesita una superficie de vista previa (SurfaceTexture es de API 11): el
     SurfaceView queda detrás, tapado por el panel negro, y solo se ve la dirección y la medición.
     keepScreenOn: al apagarse la pantalla se libera la cámara y se corta el video. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/camara_vista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/camara_direccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/camara_medicion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/camara_tamano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
